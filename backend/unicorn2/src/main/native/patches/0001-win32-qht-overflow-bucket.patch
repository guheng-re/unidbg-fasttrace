+/*
+ * Overflow (non-head) buckets must not use qemu_memalign/VirtualAlloc on
+ * Windows: each VirtualAlloc is 64KiB-granularity, and VirtualFree of a
+ * 64-byte block can unmap an unrelated reservation. The observed crash is
+ * qht_chain_destroy following bucket->next (offset 0x30) into unmapped
+ * host memory during TB-hash auto-resize (unicorn.dll AV in emu_start).
+ */
+static void *qht_alloc_overflow_bucket(void)
+{
+    void *p;
+#ifdef _WIN32
+    p = _aligned_malloc(sizeof(struct qht_bucket), QHT_BUCKET_ALIGN);
+#else
+    p = qemu_memalign(QHT_BUCKET_ALIGN, sizeof(struct qht_bucket));
+#endif
+    if (p) {
+        memset(p, 0, sizeof(struct qht_bucket));
+    }
+    return p;
+}
+
+static void qht_free_overflow_bucket(void *p)
+{
+    if (!p) {
+        return;
+    }
+#ifdef _WIN32
+    _aligned_free(p);
+#else
+    qemu_vfree(p);
+#endif
+}
+
+static inline bool qht_overflow_ptr_ok(const struct qht_bucket *b)
+{
+    uintptr_t p = (uintptr_t)b;
+
+    /* NULL is valid "end of chain". Non-NULL must be 64-byte aligned. */
+    return p != 0 && (p & (QHT_BUCKET_ALIGN - 1)) == 0;
+}
+
 static inline void qht_chain_destroy(const struct qht_bucket *head)
 {
     struct qht_bucket *curr = head->next;
     struct qht_bucket *prev;
+    size_t n = 0;
 
+    if (curr && !qht_overflow_ptr_ok(curr)) {
+        return;
+    }
     while (curr) {
         prev = curr;
         curr = curr->next;
-        qemu_vfree(prev);
+        if (curr && !qht_overflow_ptr_ok(curr)) {
+            curr = NULL;
+        }
+        /* Cycle / smashed list: stop instead of walking off into the heap. */
+        if (++n > 1000000u) {
+            qht_free_overflow_bucket(prev);
+            break;
+        }
+        qht_free_overflow_bucket(prev);
     }
 }
 
